# PostgreSQL (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ahdah?schema=public"

# Generate a long random value in production (required)
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public base URL used in QR delivery links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth. Register this exact callback in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# MVP adapters: mock | s3 (future), console | taqnyat (future), mock | moyasar (future)
STORAGE_DRIVER="mock"
MESSAGING_DRIVER="console"
PAYMENT_DRIVER="mock"

# Provider credentials reserved for the production integrations.
TAQNYAT_API_KEY=""
TAQNYAT_SENDER=""
MOYASAR_SECRET_KEY=""

# Seeded demo OTP; leave disabled in production
ENABLE_DEMO_OTP="true"
