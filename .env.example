# PostgreSQL (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ahdah?schema=public"

# Generate a long random value in production (required)
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Public base URL used in QR delivery links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MVP adapters: mock | s3 (future), console | sms (future), mock | gateway (future)
STORAGE_DRIVER="mock"
MESSAGING_DRIVER="console"
PAYMENT_DRIVER="mock"

# Seeded demo OTP; leave disabled in production
ENABLE_DEMO_OTP="true"
