# PostgreSQL (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ahdah?schema=public"

# Generate long independent random values in production (required).
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional dedicated secret for OTP hashes. If empty, SESSION_SECRET is used.
OTP_HASH_SECRET=""

# Public base URL used in OAuth and QR delivery links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth. Register this exact callback in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# MVP adapters: mock | s3 (future), console | authentica, mock | moyasar (future)
STORAGE_DRIVER="mock"
MESSAGING_DRIVER="console"
PAYMENT_DRIVER="mock"

# Authentica OTP. Production must use a real messaging provider such as authentica.
AUTHENTICA_API_KEY=""
AUTHENTICA_BASE_URL="https://api.authentica.sa"

# Payment provider reserved for the production integration.
MOYASAR_SECRET_KEY=""

# Admin access. Prefer immutable user IDs. Verified emails may also be listed.
# Comma-separated values; never commit real production identifiers here.
ADMIN_USER_IDS=""
ADMIN_EMAILS=""

# Demo OTP is for local development only. Production code ignores demo mode.
ENABLE_DEMO_OTP="false"
