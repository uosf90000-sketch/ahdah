generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  SENDER
  TRAVELER
  BOTH
}

enum ShipmentStatus {
  NEW
  RECEIVING_OFFERS
  TRAVELER_ACCEPTED
  INSPECTED
  WITH_TRAVELER
  ARRIVED
  DELIVERED
  CANCELLED
}

enum ShipmentCategory {
  DOCUMENTS
  CLOTHING
  ELECTRONICS
  GIFTS
  PERSONAL_ITEMS
  OTHER
}

enum PhotoKind {
  ORIGINAL
  INSPECTION
  DELIVERY
}

enum TripStatus {
  OPEN
  FULL
  DEPARTED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  RESERVED
  CAPTURED
  RELEASED
  CANCELLED
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  phone            String?
  role             AccountRole     @default(BOTH)
  passwordHash     String
  googleSubject    String?         @unique
  emailVerifiedAt  DateTime?
  policyAcceptedAt DateTime?
  policyVersion    String?         @db.VarChar(20)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  pushDevices      PushDevice[]
  sentShipments    Shipment[]      @relation("ShipmentSender")
  trips            Trip[]
  offers           Offer[]
  photos           ShipmentPhoto[]
  inspections      Inspection[]
  statusEvents     StatusEvent[]
  ratingsGiven     Rating[]        @relation("RatingAuthor")
  ratingsReceived  Rating[]        @relation("RatingTarget")
  chatMessages     ChatMessage[]   @relation("ChatMessageSender")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushDevice {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(4096)
  platform  String   @db.VarChar(20)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Shipment {
  id                   String           @id @default(cuid())
  refCode              String           @unique
  senderId             String
  sender               User             @relation("ShipmentSender", fields: [senderId], references: [id], onDelete: Restrict)
  fromCity              String
  toCity                String
  pickupLat             Float?
  pickupLng             Float?
  pickupNote            String?          @db.VarChar(300)
  deliveryLat           Float?
  deliveryLng           Float?
  deliveryNote          String?          @db.VarChar(300)
  transportPreference   String           @default("ANY")
  weightKg              Decimal          @db.Decimal(8, 2)
  lengthCm              Decimal          @db.Decimal(8, 2)
  widthCm               Decimal          @db.Decimal(8, 2)
  heightCm              Decimal          @db.Decimal(8, 2)
  category              ShipmentCategory
  contents              String           @db.Text
  approximateValueSar   Decimal          @db.Decimal(12, 2)
  requestedDeliveryAt   DateTime
  recipientName         String
  recipientPhone        String
  status                ShipmentStatus   @default(NEW)
  qrToken               String           @unique
  deliveryOtpHash       String?
  deliveryOtpExpiresAt  DateTime?
  deliveryOtpAttempts   Int              @default(0)
  deliveryOtpLastSentAt DateTime?
  acceptedOfferId       String?          @unique
  acceptedOffer         Offer?           @relation("AcceptedOffer", fields: [acceptedOfferId], references: [id], onDelete: SetNull)
  photos                ShipmentPhoto[]
  offers                Offer[]          @relation("ShipmentOffers")
  inspection            Inspection?
  statusEvents          StatusEvent[]
  payment               Payment?
  ratings               Rating[]
  chatMessages          ChatMessage[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([senderId, status])
  @@index([fromCity, toCity, requestedDeliveryAt])
}

model ShipmentPhoto {
  id           String    @id @default(cuid())
  shipmentId   String
  shipment     Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  kind         PhotoKind
  url          String    @db.Text
  caption      String?
  createdAt    DateTime  @default(now())

  @@index([shipmentId, kind])
}

model Trip {
  id                String      @id @default(cuid())
  travelerId        String
  traveler          User        @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  fromCity          String
  toCity            String
  departureAt       DateTime
  airline           String
  flightNumber      String?
  availableWeightKg Decimal     @db.Decimal(8, 2)
  status            TripStatus  @default(OPEN)
  offers            Offer[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([travelerId, status])
  @@index([fromCity, toCity, departureAt, status])
}

model Offer {
  id          String       @id @default(cuid())
  shipmentId  String
  shipment    Shipment     @relation("ShipmentOffers", fields: [shipmentId], references: [id], onDelete: Cascade)
  tripId      String
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelerId  String
  traveler    User         @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  priceSar    Decimal      @db.Decimal(10, 2)
  note        String?
  status      OfferStatus  @default(PENDING)
  acceptedFor Shipment?    @relation("AcceptedOffer")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([shipmentId, tripId])
  @@index([travelerId, status])
}

model Inspection {
  id                  String    @id @default(cuid())
  shipmentId          String    @unique
  shipment            Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  travelerId          String
  traveler            User      @relation(fields: [travelerId], references: [id], onDelete: Restrict)
  matchedDescription  Boolean
  matchedPhotos       Boolean
  noProhibitedItems   Boolean
  packageSealed       Boolean
  notes               String?   @db.Text
  signedAt            DateTime  @default(now())
}

model StatusEvent {
  id         String          @id @default(cuid())
  shipmentId String
  shipment   Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  status     ShipmentStatus
  note       String?
  createdAt  DateTime        @default(now())

  @@index([shipmentId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  shipmentId  String        @unique
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  amountSar   Decimal       @db.Decimal(10, 2)
  status      PaymentStatus @default(RESERVED)
  provider    String        @default("mock")
  providerRef String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Rating {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId   String
  target     User     @relation("RatingTarget", fields: [targetId], references: [id], onDelete: Cascade)
  score      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([shipmentId, authorId, targetId])
  @@index([targetId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  body       String   @db.VarChar(1000)
  createdAt  DateTime @default(now())

  @@index([shipmentId, createdAt])
  @@index([senderId, createdAt])
}
