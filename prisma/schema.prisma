generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  SENDER
  TRAVELER
  BOTH
}

enum ShipmentStatus {
  NEW
  RECEIVING_OFFERS
  TRAVELER_ACCEPTED
  INSPECTED
  WITH_TRAVELER
  ARRIVED
  DELIVERED
  CANCELLED
}

enum ShipmentCategory {
  DOCUMENTS
  CLOTHING
  ELECTRONICS
  GIFTS
  PERSONAL_ITEMS
  OTHER
}

enum PhotoKind {
  ORIGINAL
  INSPECTION
  DELIVERY
}

enum TripStatus {
  OPEN
  FULL
  DEPARTED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  RESERVED
  CAPTURED
  RELEASED
  CANCELLED
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  phone            String?
  role             AccountRole     @default(BOTH)
  passwordHash     String
  googleSubject    String?         @unique
  emailVerifiedAt  DateTime?
  policyAcceptedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  pushDevices      PushDevice[]
  sentShipments    Shipment[]      @relation("ShipmentSender")
  trips            Trip[]
  offers           Offer[]
  photos           ShipmentPhoto[]
  inspections      Inspection[]
  statusEvents     StatusEvent[]
  ratingsGiven     Rating[]        @relation("RatingAuthor")
  ratingsReceived  Rating[]        @relation("RatingTarget")
  chatMessages     ChatMessage[]   @relation("ChatMessageSender")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushDevice {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(4096)
  platform  String   @db.VarChar(20)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Shipment {
  id                   String           @id @default(cuid())
  refCode              String           @unique
  senderId             String
  sender               User             @relation("ShipmentSender", fields: [senderId], references: [id], onDelete: Restrict)
  fromCity              String
  toCity                String
  pickupLat             Float?
  pickupLng             Float?
  pickupNote            String?          @db.VarChar(300)
  deliveryLat           Float?
  deliveryLng           Float?
  deliveryNote          String?          @db.VarChar(300)
  transportPreference   String           @default("ANY")
  requestedDeliveryAt  DateTime
  weightKg              Int
  lengthCm              Int
  widthCm               Int
  heightCm              Int
  category              ShipmentCategory
  contents              String           @db.VarChar(1500)
  approximateValueSar   Int
  recipientName         String
  recipientPhone        String
  status                ShipmentStatus   @default(NEW)
  qrToken               String           @unique
  deliveryOtpHash       String?
  deliveryOtpExpiresAt  DateTime?
  deliveryOtpAttempts   Int              @default(0)
  deliveryOtpLastSentAt DateTime?
  acceptedOfferId       String?          @unique
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  photos                ShipmentPhoto[]
  offers                Offer[]
  acceptedOffer         Offer?           @relation("AcceptedOffer", fields: [acceptedOfferId], references: [id], onDelete: SetNull)
  inspection            Inspection?
  statusEvents          StatusEvent[]
  payment               Payment?
  ratings               Rating[]
  chatMessages          ChatMessage[]

  @@index([senderId])
  @@index([status, createdAt])
  @@index([fromCity, toCity, weightKg, status])
}

model ShipmentPhoto {
  id           String     @id @default(cuid())
  shipmentId   String
  shipment     Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  kind         PhotoKind
  url          String
  storageKey   String?
  mimeType     String?
  sizeBytes    Int?
  caption      String?
  createdAt    DateTime   @default(now())

  @@index([shipmentId, kind])
}

model Trip {
  id                String     @id @default(cuid())
  travelerId        String
  traveler          User       @relation(fields: [travelerId], references: [id], onDelete: Restrict)
  fromCity          String
  toCity            String
  departureAt       DateTime
  airline           String
  flightNumber      String?
  availableWeightKg Int
  status            TripStatus @default(OPEN)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  offers            Offer[]

  @@index([travelerId, departureAt])
  @@index([fromCity, toCity, departureAt, status])
}

model Offer {
  id          String      @id @default(cuid())
  shipmentId  String
  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  travelerId  String
  traveler    User        @relation(fields: [travelerId], references: [id], onDelete: Restrict)
  tripId      String
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Restrict)
  priceSar    Int
  note        String?     @db.VarChar(500)
  status      OfferStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  acceptedFor Shipment?   @relation("AcceptedOffer")

  @@unique([shipmentId, travelerId])
  @@index([shipmentId, status])
  @@index([travelerId, status])
}

model Inspection {
  id                 String   @id @default(cuid())
  shipmentId         String   @unique
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  travelerId         String
  traveler           User     @relation(fields: [travelerId], references: [id], onDelete: Restrict)
  matchedDescription Boolean
  matchedPhotos      Boolean
  noProhibitedItems  Boolean
  packageSealed      Boolean
  notes              String?  @db.VarChar(1000)
  createdAt          DateTime @default(now())
}

model StatusEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@index([shipmentId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  shipmentId  String        @unique
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  amountSar   Int
  status      PaymentStatus @default(RESERVED)
  providerRef String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Rating {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  targetId   String
  target     User     @relation("RatingTarget", fields: [targetId], references: [id], onDelete: Restrict)
  score      Int
  comment    String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@unique([shipmentId, authorId])
  @@index([targetId, createdAt])
}

model ChatMessage {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  body       String   @db.VarChar(1000)
  createdAt  DateTime @default(now())

  @@index([shipmentId, createdAt])
  @@index([senderId, createdAt])
}
